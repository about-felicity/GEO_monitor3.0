# Copy to config/remote_worker.env. Never commit the real token.
# Public HTTPS address of the dashboard backend, without a trailing slash.
MONITOR_TASK_SERVER=https://panel.example.com

# Must equal MONITOR_WORKER_TOKEN on the server. Use a long random value.
MONITOR_WORKER_TOKEN=

# Friendly name shown in task events.
MONITOR_WORKER_ID=office-desktop
