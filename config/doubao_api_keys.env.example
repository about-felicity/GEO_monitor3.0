# API keys for Doubao product/source AI extraction.
# Copy this file to doubao_api_keys.env (same directory) and fill in your keys.
# Lines starting with # are ignored.

# DeepSeek key used by product/brand AI analysis. Web scraping does not need it.
DEEPSEEK_API_KEY=

# A real Anthropic key can be used instead; DeepSeek takes this compatibility
# slot automatically when DEEPSEEK_API_KEY is configured.
ANTHROPIC_API_KEY=

ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# OpenAI is used as fallback; optional.
OPENAI_API_KEY=

# Model used for product review when ANTHROPIC_API_KEY is set.
DOUBAO_PRODUCT_AI_MODEL=deepseek-v4-flash

# AI mode: required | fallback | off. Leave empty to auto-enable when a key exists.
DOUBAO_PRODUCT_AI_MODE=
