# Generate each value independently, for example: openssl rand -hex 32
# Shared with authorized dashboard users. It permits task creation/list/cancel only.
MONITOR_TASK_API_TOKEN=

# Shared only with the owner's local worker. Never give this to dashboard users.
MONITOR_WORKER_TOKEN=

# Administrator report center. Store a PBKDF2 hash, never plaintext.
MONITOR_ADMIN_USERNAME=admin
MONITOR_ADMIN_PASSWORD_HASH=
MONITOR_ADMIN_SESSION_SECRET=

MONITOR_REMOTE_TASK_DB=/app/runtime/remote_tasks.sqlite3
